# ============================================================
# Firebase (server) — required
# ============================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
# ...or inline JSON (escape newlines in private_key as \n)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ============================================================
# Firebase (client/public) — required for auth REST calls
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# ============================================================
# App URL — used for links in emails
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Email verification (Resend) — optional
# Without RESEND_API_KEY, app still works but can't send
# verification emails (banner shows a clear message instead).
# ============================================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=BasketStar <you@yourdomain.com>

# ============================================================
# AI features — optional, provider-agnostic
# AI_PROVIDER: openai | anthropic | custom
# "custom" = any OpenAI-compatible API (Gemini, Groq, OpenRouter,
# Together, local LM Studio/Ollama...). Set AI_BASE_URL too.
# Falls back to rule-based search when not configured.
# ============================================================
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
